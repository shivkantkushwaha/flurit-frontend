# Flurit Frontend - Environment Variables Template
# Copy this file to .env.local for local overrides.
# NEVER commit .env.local or expose private keys/service roles.

# Backend API Configuration
# Deployed FastAPI backend on Render:
NEXT_PUBLIC_API_BASE_URL=https://flurit-backend.onrender.com/api/v1
# Alternative legacy variable name supported:
# NEXT_PUBLIC_API_URL=https://flurit-backend.onrender.com

# Mock Service Worker (MSW) in Browser Development
# Set to 'true' to mock backend endpoints in local browser development.
NEXT_PUBLIC_ENABLE_MSW=false

# Supabase Authentication (Browser-Safe Anon Key)
# Project URL: https://mnxliofkpmhpsvoechlk.supabase.co
# Get the anon public key from the Supabase project dashboard -> Settings -> API.
# WARNING: NEVER expose service_role key, DB connection strings, or JWT signing secrets here!
NEXT_PUBLIC_SUPABASE_URL=https://mnxliofkpmhpsvoechlk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

